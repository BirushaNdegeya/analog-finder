# ==============================================================================
# Dockerfile.api — GeoCongo AI Analog Finder Backend (FastAPI REST Engine)
# ==============================================================================
FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system dependencies for geospatial calculations (rasterio, GDAL, scipy, curl)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgdal-dev \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt pyproject.toml README.md ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code and configuration assets
COPY src/ src/
COPY config/ config/
COPY data/processed/ data/processed/

# Install local package in editable mode
RUN pip install --no-cache-dir --no-deps -e .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/v1/health || exit 1

CMD ["uvicorn", "analog_finder.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
